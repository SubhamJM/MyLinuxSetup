{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  󰁕  ",
        "color": {
            "separator": "black"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": " ",
            "keyColor": "magenta",
            "format": "The Notorius SLEEPER"
        },
        {
            "type": "os",
            "key": "󰣇 ",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "wm",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠 ",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "󰻑 ",
            "keyColor": "cyan",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "󰾆 ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󰅐 ",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break"
    ]
}
